0011 0000 0000 0000;程序的起始位置在x3000
0101 001 001 100000;R1清零
0001 001 001 100001;R1设为x01
0101 011 011 100000;R3清零 R3计算个数
0101 100 100 100000;R4清零，存放数据
1010 100 011111111;将数据导入R4
0101 101 100 000 001;相与结果放在R5
0001 101 101 111111;R5-1
0000 100 000000010;判断PC+1
0001 001 001 000 001;R1自加
0001 011 011 100001;R3+1
0000 100 111111011;PC-5
1011 011 000001000;将R3的值存储在X3501
1111 0000 00100101;程序停止
