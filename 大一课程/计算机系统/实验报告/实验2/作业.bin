0011 0000 0000 0000;初始化起始位置为x3000
;
0010 010 000010000;获取R2
0010 011 000010000;获取R3
;
1001 100 011 111111;
0001 100 100 1 00001;R4=-R3
0001 001 010 000 100;R1=R2-R3
0000 001 000000101;BRp+5
0000 100 000000010;BRn+2
0101 001 001 1 00000;R1=0
0000 111 000000011;无条件跳转+3
0001 001 011 1 00000;R1=R3
0000 111 000000001;无条件跳转+1
0001 001 010 1 00000;R1=R2
1111 0000 0010 0101;程序终止

